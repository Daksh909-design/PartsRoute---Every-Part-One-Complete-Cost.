# Copy to .env.local. Never commit keys.
DATABASE_URL=postgresql://partsroute:partsroute@localhost:5432/partsroute
TINYFISH_API_KEY=
# Gemini is the default to allow testing within its available free-tier quota.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_REQUEST_INTERVAL_MS=0
GEMINI_CONCURRENCY=8
GEMINI_TIMEOUT_MS=30000
# Shared processing window; expiry returns partial results, not verified totals.
QUOTE_COLLECTION_BUDGET_MS=26000
# Bound individual slow pages so the batch can retain successful URLs.
FETCH_PER_URL_TIMEOUT_MS=8000
# Optional paid provider: set AI_PROVIDER=openai to use the existing adapter.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Shared team access token, at least 24 characters. Required for all live endpoints.
APP_ACCESS_TOKEN=
# New live quotes per team token per rolling hour. Use 0 for unlimited local testing.
LIVE_QUOTES_PER_HOUR=6
APP_ORIGIN=http://localhost:3000
# Exact additional browser origins allowed to call the server (no paths).
APP_ALLOWED_ORIGINS=https://daksh909-design.github.io
# Optional HTTPS backend origin for a Pages build; never put a key here.
NEXT_PUBLIC_API_BASE_URL=
OBSERVATION_TTL_SECONDS=900
MAX_BROWSER_CHECKS=3
